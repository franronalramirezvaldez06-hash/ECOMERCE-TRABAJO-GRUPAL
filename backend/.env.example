# --- Base de datos (docker compose) ---
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
DB_PORT=5432
API_PORT=8080

# --- Entorno ---
# development: valores por defecto utiles (JWT y admin de prueba, CORS abierto, pasarelas simuladas)
# production:  JWT_SECRET obligatorio (>= 32 caracteres), sin CORS ni pasarelas simuladas por defecto
APP_ENV=development

# --- Seguridad ---
# Genera uno con:  openssl rand -hex 32
JWT_SECRET=
JWT_TTL_HOURS=24
# Administrador inicial (se crea al arrancar si no existe). En desarrollo, si se omite:
# admin@ecommerce.local / Admin12345!
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Origenes permitidos para CORS, separados por coma (ej. https://mitienda.com)
ALLOWED_ORIGINS=
# true solo si hay un proxy/balanceador confiable delante (usa X-Forwarded-For para el limite por IP)
TRUST_PROXY=false
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=60

# --- Negocio ---
CURRENCY=PEN
SHIPPING_CENTS=500
FREE_SHIPPING_OVER_CENTS=10000
MAX_PAYMENT_CENTS=500000

# --- Pasarelas de pago ---
# Con una clave de Stripe se usa la pasarela REAL (modo prueba: sk_test_...)
STRIPE_SECRET_KEY=
# Pasarelas simuladas (no cobran). Por defecto: true en development, false en production
ENABLE_SIMULATED_GATEWAYS=

# --- Solo para ejecutar la API fuera de docker (go run ./cmd/api) ---
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce?sslmode=disable
HTTP_PORT=8080
